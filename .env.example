# Environment variables for Real-Time Face Swap Camera
# Copy to .env and configure as needed.

APP_ENV=development
LOG_LEVEL=INFO

# Overrides (optional)
DEFAULT_CAMERA_INDEX=0
FORCE_PROVIDER=auto  # auto, CUDAExecutionProvider, DmlExecutionProvider, CPUExecutionProvider

# Paths
MODELS_DIR=models
FACES_DIR=faces
DATASETS_DIR=datasets
OUTPUTS_DIR=outputs
